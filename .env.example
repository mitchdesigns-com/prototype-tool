# Admin password for the Prototype workspace. Leave empty for local dev (no sign-in).
ADMIN_PASSWORD=
# API port (dev; production uses PORT), and the port of the masked preview origin (must be a different origin).
API_PORT=5181
PROXY_PORT=5182
# Production: a dedicated subdomain for previews, e.g. https://preview.mitchdesigns.com
# When set, requests whose Host matches it are served by the preview proxy on PORT.
PROXY_ORIGIN=
